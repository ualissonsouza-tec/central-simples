# Ambiente
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://seu-dominio.com.br
TRIAL_DAYS=30

# Acesso master
MASTER_USERNAME=admin
MASTER_PASSWORD=troque-por-uma-senha-forte

# Sessao/JWT
JWT_SECRET=troque-por-uma-chave-aleatoria-com-32-caracteres-ou-mais

# Banco de dados
# Desenvolvimento local atual:
DB_PATH=./central_simples.db
# Producao futura com PostgreSQL:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# PGSSLMODE=require
# PG_POOL_MAX=5

# Politica de privacidade
PRIVACY_VERSION=2026-05-09

# Recuperacao de senha por e-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Notificacoes push PWA
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@seu-dominio.com.br

# WhatsApp Cloud API oficial da Meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_FOLLOWUP=
WHATSAPP_TEMPLATE_CHARGE=
WHATSAPP_TEMPLATE_RECURRING_CHARGE=

# Gateway de pagamento
PAYMENT_GATEWAY=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
